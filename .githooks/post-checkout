#!/bin/sh
# On a new worktree: create venv, install the project, and configure PyCharm.
# Enable with: git config core.hooksPath .githooks
#
# Args: $1=prev HEAD, $2=new HEAD, $3=1 if branch checkout (vs file checkout)

[ "$3" = "1" ] || exit 0
[ -d "venv" ] && exit 0

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;;
    *)                    IS_WINDOWS=0 ;;
esac

for candidate in python3 python py; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null || continue
    PYTHON=$candidate
    break
done
if [ -z "$PYTHON" ]; then
    echo "post-checkout: no Python >= 3.10 found, skipping venv setup" >&2
    exit 0
fi

cat > .venv-setup.py <<'PYEOF'
import datetime
import os
import subprocess
import sys

wt = os.path.dirname(os.path.abspath(__file__))
os.chdir(wt)
log = open(".venv-setup.log", "w")


def msg(m):
    log.write(f"[{datetime.datetime.now()}] {m}\n")
    log.flush()


msg(f"Creating venv with {sys.executable}...")
rc = subprocess.call(
    [sys.executable, "-m", "venv", "venv"], stdout=log, stderr=log
)
if rc != 0 or not os.path.isdir("venv"):
    msg("Failed to create venv")
    log.close()
    sys.exit(1)

pip = os.path.join(
    "venv", "Scripts" if os.name == "nt" else "bin", "pip"
)

msg("Installing pyaccess editable (dev + lsp extras)...")
rc = subprocess.call([pip, "install", "-e", ".[dev,lsp]"], stdout=log, stderr=log)
if rc != 0:
    rc = subprocess.call([pip, "install", "-e", "."], stdout=log, stderr=log)
    msg(f"Fell back to plain editable install (rc={rc})")

os.makedirs(".idea", exist_ok=True)
v = f"{sys.version_info.major}.{sys.version_info.minor}"
with open(os.path.join(".idea", "misc.xml"), "w") as f:
    f.write(f'<?xml version="1.0" encoding="UTF-8"?>\n<project version="4">\n  <component name="ProjectRootManager" version="2" project-jdk-name="Python {v} (venv)" project-jdk-type="Python SDK" />\n</project>\n')
msg(f"PyCharm configured for Python {v}")
msg("Done")
log.close()
os.remove(__file__)
PYEOF

if [ "$IS_WINDOWS" = "1" ]; then
    PYTHON_PATH="$(cygpath -w "$(command -v "$PYTHON")")"
    SETUP_PATH="$(pwd -W)/.venv-setup.py"
    powershell.exe -NoProfile -Command "Start-Process -FilePath '$PYTHON_PATH' -ArgumentList '$SETUP_PATH' -WindowStyle Hidden" </dev/null >/dev/null 2>&1
else
    nohup "$PYTHON" "$(pwd)/.venv-setup.py" </dev/null >/dev/null 2>&1 &
fi

echo "Venv setup started in background (see .venv-setup.log)"
exit 0
